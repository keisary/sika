# --- Sika — variables d'environnement (copier vers .env et adapter) ---

# Base de données : PostgreSQL en production (Render) ; SQLite en local/dev.
DATABASE_URL=sqlite:///./sika_dev.db

# Clé secrète : signe les jetons d'accès (HMAC). En prod : valeur longue et aléatoire.
SIKA_SECRET_KEY=change-me-en-production

# PIN du compte démo créé au premier démarrage (seed) — 4 à 6 chiffres.
SIKA_SEED_PIN=1234

# AssemblyAI (Voice Agent API) : clé API + identifiant de l'agent publié.
ASSEMBLYAI_API_KEY=
SIKA_AGENT_ID=

# Fournisseur WhatsApp/SMS : désactivé si vide (le provider console/journal est utilisé).
NOTIF_PROVIDER=console
NOTIF_API_KEY=
NOTIF_SENDER=
